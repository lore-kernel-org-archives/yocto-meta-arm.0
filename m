> ++chown_chmod_by_reference() {
> ++    local reference_file="$1"
> ++    local target_file="$2"
> ++
> ++    local owner=$(stat -c "%u:%g" "$reference_file")
> ++    local perm=$(stat -c "%a" "$reference_file")
